{
  "file": "ui/EditorShell.tsx",
  "classes": [
    "btn"
  ],
  "cssRules": [
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    }
  ],
  "inlineStyleBlocks": [
    "{{ width: \"100%\", height: \"100vh\", display: \"flex\", flexDirection: \"column\", background: \"var(--bg-app)\" }}",
    "{{ height: 56, flex: \"0 0 auto\", display: \"flex\", alignItems: \"center\", gap: 20, padding: \"0 16px\", background: \"var(--bg-panel)\", borderBottom: \"1px solid var(--border)\" }}",
    "{{ fontWeight: 800, fontSize: 15, letterSpacing: \"-0.01em\" }}",
    "{{ flex: 1 }}",
    "{{ flex: 1 }}",
    "{{ borderRadius: 8, padding: 8, background: \"transparent\", borderColor: \"transparent\", gap: 6 }}",
    "{{ borderRadius: 8, padding: 8, background: \"transparent\", borderColor: \"transparent\", gap: 6 }}",
    "{{ borderRadius: 8, padding: \"7px 12px\", fontSize: 12, fontWeight: 600, gap: 6 }}",
    "{{ borderRadius: 8, padding: \"7px 12px\", fontSize: 12, fontWeight: 600, gap: 6 }}",
    "{{ borderRadius: 8, padding: \"7px 12px\", fontSize: 12, fontWeight: 600, gap: 6 }}",
    "{{ flex: 1, display: \"flex\", minHeight: 0, position: \"relative\" }}",
    "{{ width: 248, flex: \"0 0 auto\", background: \"var(--bg-panel)\", borderRight: \"1px solid var(--border)\", overflowY: \"auto\", padding: 16, display: \"flex\", flexDirection: \"column\", gap: 20 }}",
    "{{ width: 248, flex: \"0 0 auto\", background: \"var(--bg-panel)\", borderRight: \"1px solid var(--border)\", overflowY: \"auto\", padding: 16, display: \"flex\", flexDirection: \"column\", gap: 20 }}",
    "{{ width: 248, flex: \"0 0 auto\", background: \"var(--bg-panel)\", borderRight: \"1px solid var(--border)\", overflowY: \"auto\", padding: 16, display: \"flex\", flexDirection: \"column\", gap: 20 }}",
    "{{ width: 248, flex: \"0 0 auto\", background: \"var(--bg-panel)\", borderRight: \"1px solid var(--border)\", overflowY: \"auto\", padding: 16, display: \"flex\", flexDirection: \"column\", gap: 20 }}",
    "{{ width: 248, flex: \"0 0 auto\", background: \"var(--bg-panel)\", borderRight: \"1px solid var(--border)\", overflowY: \"auto\", padding: 16, display: \"flex\", flexDirection: \"column\", gap: 20 }}",
    "{{ flex: 1, minWidth: 0, display: \"flex\", position: \"relative\" }}",
    "{{ width: 260, flex: \"0 0 auto\", background: \"var(--bg-panel)\", borderLeft: \"1px solid var(--border)\" }}"
  ]
}