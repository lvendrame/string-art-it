{
  "file": "ui/EditorShell.tsx",
  "classes": [
    "btn",
    "editor-shell",
    "editor-shell__body",
    "editor-shell__canvas-area",
    "editor-shell__icon-btn",
    "editor-shell__layers-panel",
    "editor-shell__logo",
    "editor-shell__side-panel",
    "editor-shell__spacer",
    "editor-shell__toolbar-btn",
    "editor-shell__topbar"
  ],
  "cssRules": [
    {
      "selector": ".editor-shell",
      "file": "ui/EditorShell.css",
      "declarations": {
        "width": "100%",
        "height": "100vh",
        "display": "flex",
        "flex-direction": "column",
        "background": "var(--bg-app)"
      }
    },
    {
      "selector": ".editor-shell__topbar",
      "file": "ui/EditorShell.css",
      "declarations": {
        "height": "56px",
        "flex": "0 0 auto",
        "display": "flex",
        "align-items": "center",
        "gap": "20px",
        "padding": "0 16px",
        "background": "var(--bg-panel)",
        "border-bottom": "1px solid var(--border)"
      }
    },
    {
      "selector": ".editor-shell__logo",
      "file": "ui/EditorShell.css",
      "declarations": {
        "font-weight": "800",
        "font-size": "15px",
        "letter-spacing": "-0.01em"
      }
    },
    {
      "selector": ".editor-shell__spacer",
      "file": "ui/EditorShell.css",
      "declarations": {
        "flex": "1"
      }
    },
    {
      "selector": ".btn.editor-shell__icon-btn",
      "file": "ui/EditorShell.css",
      "declarations": {
        "border-radius": "8px",
        "padding": "8px",
        "background": "transparent",
        "border-color": "transparent",
        "gap": "6px"
      }
    },
    {
      "selector": ".editor-shell__toolbar-btn",
      "file": "ui/EditorShell.css",
      "declarations": {
        "border-radius": "8px",
        "padding": "7px 12px",
        "font-size": "12px",
        "font-weight": "600",
        "gap": "6px"
      }
    },
    {
      "selector": ".editor-shell__body",
      "file": "ui/EditorShell.css",
      "declarations": {
        "flex": "1",
        "display": "flex",
        "min-height": "0",
        "position": "relative"
      }
    },
    {
      "selector": ".editor-shell__side-panel",
      "file": "ui/EditorShell.css",
      "declarations": {
        "width": "248px",
        "flex": "0 0 auto",
        "background": "var(--bg-panel)",
        "border-right": "1px solid var(--border)",
        "overflow-y": "auto",
        "padding": "16px",
        "display": "flex",
        "flex-direction": "column",
        "gap": "20px"
      }
    },
    {
      "selector": ".editor-shell__canvas-area",
      "file": "ui/EditorShell.css",
      "declarations": {
        "flex": "1",
        "min-width": "0",
        "display": "flex",
        "position": "relative"
      }
    },
    {
      "selector": ".editor-shell__layers-panel",
      "file": "ui/EditorShell.css",
      "declarations": {
        "width": "300px",
        "flex": "0 0 auto",
        "background": "var(--bg-panel)",
        "border-left": "1px solid var(--border)"
      }
    },
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    }
  ],
  "inlineStyleBlocks": []
}