{
  "file": "ui/LanguageSwitcher.tsx",
  "classes": [
    "btn",
    "btn-active"
  ],
  "cssRules": [
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".btn-active",
      "file": "ui/theme.css",
      "declarations": {
        "background": "var(--accent-soft)",
        "color": "var(--accent)",
        "border-color": "var(--accent)"
      }
    }
  ],
  "inlineStyleBlocks": [
    "{{ position: \"relative\" }}",
    "{{ borderRadius: 8, padding: \"7px 10px\", fontSize: 12, fontWeight: 600, gap: 6 }}",
    "{{\n            position: \"absolute\",\n            top: \"110%\",\n            right: 0,\n            zIndex: 20,\n            background: \"var(--bg-panel-2)\",\n            border: \"1px solid var(--border)\",\n            borderRadius: \"var(--radius-md)\",\n            padding: 6,\n            minWidth: 170,\n            display: \"flex\",\n            flexDirection: \"column\",\n            gap: 2,\n            boxShadow: \"0 8px 24px rgba(0,0,0,0.4)\",\n          }}",
    "{{\n                justifyContent: \"space-between\",\n                border: \"none\",\n                borderRadius: \"var(--radius-sm)\",\n                padding: \"7px 10px\",\n                fontSize: 12.5,\n              }}"
  ]
}