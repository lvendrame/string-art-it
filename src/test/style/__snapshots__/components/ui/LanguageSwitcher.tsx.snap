{
  "file": "ui/LanguageSwitcher.tsx",
  "classes": [
    "btn",
    "btn-active",
    "language-switcher__option",
    "language-switcher__panel",
    "language-switcher__trigger",
    "popover-trigger"
  ],
  "cssRules": [
    {
      "selector": ".popover-trigger",
      "file": "ui/AnchoredPopover.css",
      "declarations": {
        "position": "relative"
      }
    },
    {
      "selector": ".language-switcher__trigger",
      "file": "ui/LanguageSwitcher.css",
      "declarations": {
        "border-radius": "8px",
        "padding": "7px 10px",
        "font-size": "12px",
        "font-weight": "600",
        "gap": "6px"
      }
    },
    {
      "selector": ".language-switcher__panel",
      "file": "ui/LanguageSwitcher.css",
      "declarations": {
        "padding": "6px",
        "min-width": "170px",
        "display": "flex",
        "flex-direction": "column",
        "gap": "2px"
      }
    },
    {
      "selector": ".btn.language-switcher__option",
      "file": "ui/LanguageSwitcher.css",
      "declarations": {
        "justify-content": "space-between",
        "border": "none",
        "border-radius": "var(--radius-sm)",
        "padding": "7px 10px",
        "font-size": "12.5px"
      }
    },
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".btn-active",
      "file": "ui/theme.css",
      "declarations": {
        "background": "var(--accent-soft)",
        "color": "var(--accent)",
        "border-color": "var(--accent)"
      }
    }
  ],
  "inlineStyleBlocks": []
}