{
  "file": "ui/canvas/Canvas.tsx",
  "classes": [
    "canvas-root",
    "canvas-viewport"
  ],
  "cssRules": [
    {
      "selector": ".canvas-root",
      "file": "ui/canvas/Canvas.css",
      "declarations": {
        "flex": "1",
        "display": "flex",
        "flex-direction": "column",
        "min-width": "0",
        "background": "var(--bg-canvas)"
      }
    },
    {
      "selector": ".canvas-viewport",
      "file": "ui/canvas/Canvas.css",
      "declarations": {
        "flex": "1",
        "position": "relative",
        "overflow": "hidden",
        "display": "flex",
        "align-items": "center",
        "justify-content": "center"
      }
    }
  ],
  "inlineStyleBlocks": [
    "{{\n            cursor: canvasCursor(state.mode, state.selectTool, state.pinTool, state.threadTool, pan.isPanning),\n          }}"
  ]
}