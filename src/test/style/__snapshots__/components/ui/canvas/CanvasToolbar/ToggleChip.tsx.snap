{
  "file": "ui/canvas/CanvasToolbar/ToggleChip.tsx",
  "classes": [
    "btn",
    "btn-active",
    "canvas-toolbar__chip"
  ],
  "cssRules": [
    {
      "selector": ".canvas-toolbar__chip",
      "file": "ui/canvas/CanvasToolbar/ToggleChip.css",
      "declarations": {
        "border-radius": "999px",
        "padding": "6px 12px",
        "font-size": "11.5px",
        "font-weight": "600",
        "gap": "6px"
      }
    },
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".btn-active",
      "file": "ui/theme.css",
      "declarations": {
        "background": "var(--accent-soft)",
        "color": "var(--accent)",
        "border-color": "var(--accent)"
      }
    }
  ],
  "inlineStyleBlocks": []
}