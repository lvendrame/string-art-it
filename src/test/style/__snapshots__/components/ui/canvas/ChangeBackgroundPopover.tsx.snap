{
  "file": "ui/canvas/ChangeBackgroundPopover.tsx",
  "classes": [
    "btn",
    "btn-active",
    "change-background-popover__panel",
    "change-background-popover__trigger",
    "popover-trigger"
  ],
  "cssRules": [
    {
      "selector": ".popover-trigger",
      "file": "ui/AnchoredPopover.css",
      "declarations": {
        "position": "relative"
      }
    },
    {
      "selector": ".change-background-popover__trigger",
      "file": "ui/canvas/ChangeBackgroundPopover.css",
      "declarations": {
        "border-radius": "999px",
        "padding": "6px 12px",
        "font-size": "11.5px",
        "font-weight": "600",
        "gap": "6px"
      }
    },
    {
      "selector": ".change-background-popover__panel",
      "file": "ui/canvas/ChangeBackgroundPopover.css",
      "declarations": {
        "padding": "10px",
        "display": "flex",
        "flex-direction": "column",
        "gap": "8px",
        "min-width": "220px"
      }
    },
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".btn-active",
      "file": "ui/theme.css",
      "declarations": {
        "background": "var(--accent-soft)",
        "color": "var(--accent)",
        "border-color": "var(--accent)"
      }
    }
  ],
  "inlineStyleBlocks": []
}