{
  "file": "ui/canvas/GridSettingsPopover.tsx",
  "classes": [
    "btn",
    "btn-active",
    "grid-settings-popover__color-input",
    "grid-settings-popover__number-input",
    "grid-settings-popover__number-input--opacity",
    "grid-settings-popover__panel",
    "grid-settings-popover__row",
    "grid-settings-popover__trigger",
    "mono",
    "popover-trigger"
  ],
  "cssRules": [
    {
      "selector": ".popover-trigger",
      "file": "ui/AnchoredPopover.css",
      "declarations": {
        "position": "relative"
      }
    },
    {
      "selector": ".grid-settings-popover__trigger",
      "file": "ui/canvas/GridSettingsPopover.css",
      "declarations": {
        "border-radius": "999px",
        "padding": "6px 12px",
        "font-size": "11.5px",
        "font-weight": "600",
        "gap": "6px"
      }
    },
    {
      "selector": ".grid-settings-popover__panel",
      "file": "ui/canvas/GridSettingsPopover.css",
      "declarations": {
        "padding": "10px",
        "display": "flex",
        "flex-direction": "column",
        "gap": "8px",
        "min-width": "160px"
      }
    },
    {
      "selector": ".grid-settings-popover__row",
      "file": "ui/canvas/GridSettingsPopover.css",
      "declarations": {
        "display": "flex",
        "justify-content": "space-between",
        "align-items": "center",
        "gap": "8px",
        "font-size": "11px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".grid-settings-popover__number-input",
      "file": "ui/canvas/GridSettingsPopover.css",
      "declarations": {
        "width": "60px",
        "background": "var(--bg-panel-2)",
        "border": "1px solid var(--border)",
        "border-radius": "6px",
        "color": "var(--text-primary)",
        "padding": "3px 6px",
        "font-size": "11px"
      }
    },
    {
      "selector": ".grid-settings-popover__number-input--opacity",
      "file": "ui/canvas/GridSettingsPopover.css",
      "declarations": {
        "width": "56px"
      }
    },
    {
      "selector": ".grid-settings-popover__color-input",
      "file": "ui/canvas/GridSettingsPopover.css",
      "declarations": {
        "width": "28px",
        "height": "22px",
        "border": "1px solid var(--border)",
        "border-radius": "4px",
        "background": "none",
        "padding": "0"
      }
    },
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    },
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".btn-active",
      "file": "ui/theme.css",
      "declarations": {
        "background": "var(--accent-soft)",
        "color": "var(--accent)",
        "border-color": "var(--accent)"
      }
    }
  ],
  "inlineStyleBlocks": []
}