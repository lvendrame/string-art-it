{
  "file": "ui/canvas/StatusBar.tsx",
  "classes": [
    "mono",
    "status-bar"
  ],
  "cssRules": [
    {
      "selector": ".status-bar",
      "file": "ui/canvas/StatusBar.css",
      "declarations": {
        "flex": "0 0 auto",
        "height": "32px",
        "display": "flex",
        "align-items": "center",
        "gap": "14px",
        "padding": "0 16px",
        "background": "var(--bg-panel)",
        "border-top": "1px solid var(--border)",
        "font-size": "11.5px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    }
  ],
  "inlineStyleBlocks": []
}