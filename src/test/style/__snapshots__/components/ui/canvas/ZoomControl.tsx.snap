{
  "file": "ui/canvas/ZoomControl.tsx",
  "classes": [
    "btn",
    "btn-active",
    "mono",
    "popover-trigger",
    "zoom-control__chevron",
    "zoom-control__input",
    "zoom-control__option",
    "zoom-control__panel",
    "zoom-control__trigger-row"
  ],
  "cssRules": [
    {
      "selector": ".popover-trigger",
      "file": "ui/AnchoredPopover.css",
      "declarations": {
        "position": "relative"
      }
    },
    {
      "selector": ".zoom-control__trigger-row",
      "file": "ui/canvas/ZoomControl.css",
      "declarations": {
        "display": "flex",
        "align-items": "center"
      }
    },
    {
      "selector": ".zoom-control__input",
      "file": "ui/canvas/ZoomControl.css",
      "declarations": {
        "width": "48px",
        "text-align": "center",
        "background": "var(--bg-panel-2)",
        "border": "1px solid var(--border)",
        "border-radius": "6px",
        "color": "var(--text-primary)",
        "padding": "5px 4px",
        "font-size": "12px"
      }
    },
    {
      "selector": ".zoom-control__chevron",
      "file": "ui/canvas/ZoomControl.css",
      "declarations": {
        "border-radius": "6px",
        "padding": "5px 2px",
        "margin-left": "2px"
      }
    },
    {
      "selector": ".zoom-control__panel",
      "file": "ui/canvas/ZoomControl.css",
      "declarations": {
        "padding": "6px",
        "min-width": "90px",
        "max-height": "260px",
        "overflow-y": "auto",
        "display": "flex",
        "flex-direction": "column",
        "gap": "2px"
      }
    },
    {
      "selector": ".btn.zoom-control__option",
      "file": "ui/canvas/ZoomControl.css",
      "declarations": {
        "border": "none",
        "border-radius": "var(--radius-sm)",
        "padding": "6px 8px",
        "font-size": "12px",
        "text-align": "right"
      }
    },
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    },
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".btn-active",
      "file": "ui/theme.css",
      "declarations": {
        "background": "var(--accent-soft)",
        "color": "var(--accent)",
        "border-color": "var(--accent)"
      }
    }
  ],
  "inlineStyleBlocks": []
}