{
  "file": "ui/panels/BoardAppearancePanel.tsx",
  "classes": [
    "board-appearance-panel",
    "board-appearance-panel__color-swatch",
    "board-appearance-panel__coord-label",
    "board-appearance-panel__file-input",
    "board-appearance-panel__number-input",
    "board-appearance-panel__number-input--direction",
    "board-appearance-panel__row",
    "board-appearance-panel__section-title",
    "board-appearance-panel__select",
    "board-appearance-panel__stack",
    "board-appearance-panel__stops-row",
    "board-appearance-panel__texture-preview",
    "board-appearance-panel__type-btn",
    "board-appearance-panel__type-grid",
    "btn",
    "btn-active",
    "mono"
  ],
  "cssRules": [
    {
      "selector": ".board-appearance-panel",
      "file": "ui/panels/BoardAppearancePanel.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "10px"
      }
    },
    {
      "selector": ".board-appearance-panel__section-title",
      "file": "ui/panels/BoardAppearancePanel.css",
      "declarations": {
        "font-size": "11px",
        "font-weight": "700",
        "letter-spacing": "0.06em",
        "color": "var(--text-tertiary)",
        "text-transform": "uppercase"
      }
    },
    {
      "selector": ".board-appearance-panel__type-grid",
      "file": "ui/panels/BoardAppearancePanel.css",
      "declarations": {
        "display": "grid",
        "grid-template-columns": "repeat(3, 1fr)",
        "gap": "6px"
      }
    },
    {
      "selector": ".board-appearance-panel__type-btn",
      "file": "ui/panels/BoardAppearancePanel.css",
      "declarations": {
        "justify-content": "center",
        "border-radius": "var(--radius-sm)",
        "padding": "9px 4px",
        "font-size": "11.5px",
        "font-weight": "600"
      }
    },
    {
      "selector": ".board-appearance-panel__row",
      "file": "ui/panels/BoardAppearancePanel.css",
      "declarations": {
        "display": "flex",
        "justify-content": "space-between",
        "align-items": "center",
        "font-size": "12px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".board-appearance-panel__color-swatch",
      "file": "ui/panels/BoardAppearancePanel.css",
      "declarations": {
        "width": "32px",
        "height": "22px",
        "border": "1px solid var(--border)",
        "border-radius": "4px",
        "background": "none"
      }
    },
    {
      "selector": ".board-appearance-panel__stack",
      "file": "ui/panels/BoardAppearancePanel.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "8px"
      }
    },
    {
      "selector": ".board-appearance-panel__stops-row",
      "file": "ui/panels/BoardAppearancePanel.css",
      "declarations": {
        "display": "flex",
        "gap": "6px"
      }
    },
    {
      "selector": ".board-appearance-panel__number-input",
      "file": "ui/panels/BoardAppearancePanel.css",
      "declarations": {
        "background": "var(--bg-app)",
        "border": "1px solid var(--border)",
        "border-radius": "6px",
        "color": "var(--text-primary)",
        "padding": "4px 6px"
      }
    },
    {
      "selector": ".board-appearance-panel__number-input--direction",
      "file": "ui/panels/BoardAppearancePanel.css",
      "declarations": {
        "width": "70px"
      }
    },
    {
      "selector": ".board-appearance-panel__coord-label",
      "file": "ui/panels/BoardAppearancePanel.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "4px",
        "font-size": "11.5px",
        "color": "var(--text-secondary)",
        "flex": "1"
      }
    },
    {
      "selector": ".board-appearance-panel__select",
      "file": "ui/panels/BoardAppearancePanel.css",
      "declarations": {
        "background": "var(--bg-app)",
        "border": "1px solid var(--border)",
        "border-radius": "6px",
        "color": "var(--text-primary)",
        "padding": "6px 8px",
        "font-size": "13px"
      }
    },
    {
      "selector": ".board-appearance-panel__file-input",
      "file": "ui/panels/BoardAppearancePanel.css",
      "declarations": {
        "font-size": "12px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".board-appearance-panel__texture-preview",
      "file": "ui/panels/BoardAppearancePanel.css",
      "declarations": {
        "width": "100%",
        "height": "60px",
        "object-fit": "cover",
        "border-radius": "6px",
        "border": "1px solid var(--border)"
      }
    },
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    },
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".btn-active",
      "file": "ui/theme.css",
      "declarations": {
        "background": "var(--accent-soft)",
        "color": "var(--accent)",
        "border-color": "var(--accent)"
      }
    }
  ],
  "inlineStyleBlocks": []
}