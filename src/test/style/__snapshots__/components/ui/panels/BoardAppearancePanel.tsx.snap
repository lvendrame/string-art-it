{
  "file": "ui/panels/BoardAppearancePanel.tsx",
  "classes": [
    "btn",
    "btn-active",
    "mono"
  ],
  "cssRules": [
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    },
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".btn-active",
      "file": "ui/theme.css",
      "declarations": {
        "background": "var(--accent-soft)",
        "color": "var(--accent)",
        "border-color": "var(--accent)"
      }
    }
  ],
  "inlineStyleBlocks": [
    "{{ display: \"flex\", flexDirection: \"column\", gap: 10 }}",
    "{{ fontSize: 11, fontWeight: 700, letterSpacing: \"0.06em\", color: \"var(--text-tertiary)\", textTransform: \"uppercase\" }}",
    "{{ display: \"grid\", gridTemplateColumns: \"repeat(3, 1fr)\", gap: 6 }}",
    "{{ justifyContent: \"center\", borderRadius: \"var(--radius-sm)\", padding: \"9px 4px\", fontSize: 11.5, fontWeight: 600 }}",
    "{{ display: \"flex\", justifyContent: \"space-between\", alignItems: \"center\", fontSize: 12, color: \"var(--text-secondary)\" }}",
    "{{ width: 32, height: 22, border: \"1px solid var(--border)\", borderRadius: 4, background: \"none\" }}",
    "{{ display: \"flex\", flexDirection: \"column\", gap: 8 }}",
    "{{ display: \"flex\", gap: 6 }}",
    "{{ width: 32, height: 22, border: \"1px solid var(--border)\", borderRadius: 4, background: \"none\" }}",
    "{{ display: \"flex\", justifyContent: \"space-between\", alignItems: \"center\", fontSize: 12, color: \"var(--text-secondary)\" }}",
    "{{ width: 70, background: \"var(--bg-app)\", border: \"1px solid var(--border)\", borderRadius: 6, color: \"var(--text-primary)\", padding: \"4px 6px\" }}",
    "{{ display: \"flex\", gap: 6 }}",
    "{{ display: \"flex\", flexDirection: \"column\", gap: 4, fontSize: 11.5, color: \"var(--text-secondary)\", flex: 1 }}",
    "{{ background: \"var(--bg-app)\", border: \"1px solid var(--border)\", borderRadius: 6, color: \"var(--text-primary)\", padding: \"4px 6px\" }}",
    "{{ display: \"flex\", flexDirection: \"column\", gap: 4, fontSize: 11.5, color: \"var(--text-secondary)\", flex: 1 }}",
    "{{ background: \"var(--bg-app)\", border: \"1px solid var(--border)\", borderRadius: 6, color: \"var(--text-primary)\", padding: \"4px 6px\" }}",
    "{{ background: \"var(--bg-app)\", border: \"1px solid var(--border)\", borderRadius: 6, color: \"var(--text-primary)\", padding: \"6px 8px\", fontSize: 13 }}",
    "{{ display: \"flex\", flexDirection: \"column\", gap: 8 }}",
    "{{ fontSize: 12, color: \"var(--text-secondary)\" }}",
    "{{ width: \"100%\", height: 60, objectFit: \"cover\", borderRadius: 6, border: \"1px solid var(--border)\" }}"
  ]
}