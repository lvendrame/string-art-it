{
  "file": "ui/panels/BoardSetup.tsx",
  "classes": [
    "board-setup",
    "board-setup__continue-btn",
    "board-setup__field-input",
    "board-setup__field-label",
    "board-setup__header",
    "board-setup__hypotenuse",
    "board-setup__section",
    "board-setup__section--wide-gap",
    "board-setup__section-title",
    "board-setup__shape-btn",
    "board-setup__shape-grid",
    "board-setup__title",
    "board-setup__triangle-btn",
    "board-setup__triangle-row",
    "btn",
    "btn-active",
    "mono"
  ],
  "cssRules": [
    {
      "selector": ".board-setup",
      "file": "ui/panels/BoardSetup.css",
      "declarations": {
        "max-width": "420px",
        "margin": "80px auto",
        "display": "flex",
        "flex-direction": "column",
        "gap": "20px",
        "padding": "24px",
        "background": "var(--bg-panel)",
        "border": "1px solid var(--border)",
        "border-radius": "var(--radius-md)"
      }
    },
    {
      "selector": ".board-setup__header",
      "file": "ui/panels/BoardSetup.css",
      "declarations": {
        "display": "flex",
        "justify-content": "space-between",
        "align-items": "center"
      }
    },
    {
      "selector": ".board-setup__title",
      "file": "ui/panels/BoardSetup.css",
      "declarations": {
        "margin": "0",
        "font-size": "18px"
      }
    },
    {
      "selector": ".board-setup__section",
      "file": "ui/panels/BoardSetup.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "8px"
      }
    },
    {
      "selector": ".board-setup__section--wide-gap",
      "file": "ui/panels/BoardSetup.css",
      "declarations": {
        "gap": "10px"
      }
    },
    {
      "selector": ".board-setup__section-title",
      "file": "ui/panels/BoardSetup.css",
      "declarations": {
        "font-size": "11px",
        "font-weight": "700",
        "letter-spacing": "0.06em",
        "color": "var(--text-tertiary)",
        "text-transform": "uppercase"
      }
    },
    {
      "selector": ".board-setup__shape-grid",
      "file": "ui/panels/BoardSetup.css",
      "declarations": {
        "display": "grid",
        "grid-template-columns": "repeat(3, 1fr)",
        "gap": "6px"
      }
    },
    {
      "selector": ".board-setup__shape-btn",
      "file": "ui/panels/BoardSetup.css",
      "declarations": {
        "justify-content": "center",
        "border-radius": "var(--radius-sm)",
        "padding": "10px 4px",
        "font-size": "12px",
        "font-weight": "600"
      }
    },
    {
      "selector": ".board-setup__triangle-row",
      "file": "ui/panels/BoardSetup.css",
      "declarations": {
        "display": "flex",
        "gap": "6px"
      }
    },
    {
      "selector": ".board-setup__triangle-btn",
      "file": "ui/panels/BoardSetup.css",
      "declarations": {
        "flex": "1",
        "justify-content": "center",
        "border-radius": "var(--radius-sm)",
        "padding": "9px",
        "font-size": "12px",
        "font-weight": "600"
      }
    },
    {
      "selector": ".board-setup__hypotenuse",
      "file": "ui/panels/BoardSetup.css",
      "declarations": {
        "font-size": "12px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".board-setup__field-label",
      "file": "ui/panels/BoardSetup.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "4px",
        "font-size": "12px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".board-setup__field-input",
      "file": "ui/panels/BoardSetup.css",
      "declarations": {
        "background": "var(--bg-app)",
        "border": "1px solid var(--border)",
        "border-radius": "var(--radius-sm)",
        "color": "var(--text-primary)",
        "padding": "6px 8px",
        "font-size": "13px"
      }
    },
    {
      "selector": ".btn.board-setup__continue-btn",
      "file": "ui/panels/BoardSetup.css",
      "declarations": {
        "justify-content": "center",
        "border-radius": "var(--radius-sm)",
        "padding": "10px",
        "font-size": "13px",
        "font-weight": "700",
        "background": "var(--accent-strong)",
        "color": "white",
        "border-color": "transparent"
      }
    },
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    },
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".btn-active",
      "file": "ui/theme.css",
      "declarations": {
        "background": "var(--accent-soft)",
        "color": "var(--accent)",
        "border-color": "var(--accent)"
      }
    }
  ],
  "inlineStyleBlocks": []
}