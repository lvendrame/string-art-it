        "border-radius": "var(--radius-md)",
        "padding": "10px"
      }
    },
    {
      "selector": ".print-preview-panel__calibration-instructions",
      "file": "ui/panels/PrintPreviewPanel.css",
      "declarations": {
        "font-size": "11.5px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".print-preview-panel__calibration-print-btn",
      "file": "ui/panels/PrintPreviewPanel.css",
