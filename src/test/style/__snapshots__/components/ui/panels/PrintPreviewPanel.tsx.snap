      }
    },
    {
      "selector": ".print-preview-panel__calibration-readout",
      "file": "ui/panels/PrintPreviewPanel.css",
      "declarations": {
        "font-size": "11px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".print-preview-panel__calibration-test-btn",
