        "font-size": "12px"
      }
    },
    {
      "selector": ".print-preview-panel__calibration-row",
      "file": "ui/panels/PrintPreviewPanel.css",
      "declarations": {
        "display": "flex",
        "gap": "6px"
      }
    },
    {
      "selector": ".print-preview-panel__calibration-apply-btn",
      "file": "ui/panels/PrintPreviewPanel.css",
      "declarations": {
        "flex": "1",
        "justify-content": "center",
        "border-radius": "6px",
        "padding": "7px",
        "font-size": "12px",
        "font-weight": "600"
      }
    },
    {
      "selector": ".print-preview-panel__calibration-cancel-btn",
      "file": "ui/panels/PrintPreviewPanel.css",
      "declarations": {
        "flex": "1",
        "justify-content": "center",
        "border-radius": "6px",
        "padding": "7px",
        "font-size": "12px"
      }
    },
