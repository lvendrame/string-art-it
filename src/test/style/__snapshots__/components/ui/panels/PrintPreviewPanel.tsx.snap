  "cssRules": [
    {
      "selector": ".print-preview-panel",
      "file": "ui/panels/PrintPreviewPanel.css",
      "declarations": {
        "display": "flex"
      }
    },
    {
      "selector": ".print-preview-panel__sidebar",
      "file": "ui/panels/PrintPreviewPanel.css",
      "declarations": {
        "width": "300px",
        "border-right": "1px solid var(--border)",
        "padding": "16px",
        "display": "flex",
        "flex-direction": "column",
        "gap": "16px",
        "overflow-y": "auto"
      }
    },
    {
      "selector": ".print-preview-panel__header",
      "file": "ui/panels/PrintPreviewPanel.css",
      "declarations": {
        "display": "flex",
        "justify-content": "space-between",
        "align-items": "center"
      }
    },
    {
      "selector": ".print-preview-panel__title",
      "file": "ui/panels/PrintPreviewPanel.css",
      "declarations": {
        "font-weight": "700",
        "font-size": "13px"
      }
    },
    {
      "selector": ".print-preview-panel__section",
      "file": "ui/panels/PrintPreviewPanel.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "8px"
      }
    },
    {
      "selector": ".print-preview-panel__section-heading",
      "file": "ui/panels/PrintPreviewPanel.css",
