        "display": "flex",
        "align-items": "center",
        "justify-content": "center",
        "overflow": "auto",
        "padding": "24px"
      }
    },
    {
      "selector": ".print-preview-panel__page-svg",
      "file": "ui/panels/PrintPreviewPanel.css",
      "declarations": {
        "background": "white"
      }
    },
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    },
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".btn-active",
      "file": "ui/theme.css",
      "declarations": {
        "background": "var(--accent-soft)",
        "color": "var(--accent)",
        "border-color": "var(--accent)"
      }
    },
    {
      "selector": ".print-tile-grid",
      "file": "ui/theme.css",
      "declarations": {
        "display": "grid",
        "gap": "16px"
      }
    },
    {
      "selector": ".print-page",
      "file": "ui/theme.css",
      "declarations": {
        "position": "relative"
      }
    }
  ],
  "inlineStyleBlocks": [
    "{{ gridTemplateColumns: `repeat(${grid.cols}, auto)` }}"
  ]
}