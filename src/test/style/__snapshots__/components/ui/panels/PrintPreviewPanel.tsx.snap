        "align-items": "center",
        "gap": "8px",
        "font-size": "12px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".print-preview-panel__row-between",
      "file": "ui/panels/PrintPreviewPanel.css",
      "declarations": {
        "display": "flex",
        "justify-content": "space-between",
        "align-items": "center",
        "font-size": "12px",
        "color": "var(--text-secondary)"
      }
    },
    {
