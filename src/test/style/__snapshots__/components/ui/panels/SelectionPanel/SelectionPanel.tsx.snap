{
  "file": "ui/panels/SelectionPanel/SelectionPanel.tsx",
  "classes": [
    "btn",
    "selection-panel",
    "selection-panel__box",
    "selection-panel__delete-btn",
    "selection-panel__empty-message",
    "selection-panel__multi-wrap",
    "selection-panel__row",
    "selection-panel__section-title",
    "selection-panel__select",
    "selection-panel__text-input"
  ],
  "cssRules": [
    {
      "selector": ".selection-panel",
      "file": "ui/panels/SelectionPanel/SelectionPanel.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "10px"
      }
    },
    {
      "selector": ".selection-panel__section-title",
      "file": "ui/panels/SelectionPanel/SelectionPanel.css",
      "declarations": {
        "font-size": "11px",
        "font-weight": "700",
        "letter-spacing": "0.06em",
        "color": "var(--text-tertiary)",
        "text-transform": "uppercase"
      }
    },
    {
      "selector": ".selection-panel__row",
      "file": "ui/panels/SelectionPanel/SelectionPanel.css",
      "declarations": {
        "display": "flex",
        "justify-content": "space-between",
        "align-items": "center",
        "font-size": "12px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".selection-panel__multi-wrap",
      "file": "ui/panels/SelectionPanel/SelectionPanel.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "10px"
      }
    },
    {
      "selector": ".selection-panel__empty-message",
      "file": "ui/panels/SelectionPanel/SelectionPanel.css",
      "declarations": {
        "color": "var(--text-tertiary)",
        "font-size": "12px"
      }
    },
    {
      "selector": ".selection-panel__box",
      "file": "ui/panels/SelectionPanel/SelectionPanel.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "8px",
        "background": "var(--bg-app)",
        "border": "1px solid var(--border)",
        "border-radius": "var(--radius-md)",
        "padding": "12px"
      }
    },
    {
      "selector": ".selection-panel__text-input",
      "file": "ui/panels/SelectionPanel/SelectionPanel.css",
      "declarations": {
        "width": "140px",
        "background": "var(--bg-panel-2)",
        "border": "1px solid var(--border)",
        "border-radius": "6px",
        "color": "var(--text-primary)",
        "padding": "4px 6px",
        "font-size": "12px"
      }
    },
    {
      "selector": ".selection-panel__select",
      "file": "ui/panels/SelectionPanel/SelectionPanel.css",
      "declarations": {
        "background": "var(--bg-panel-2)",
        "border": "1px solid var(--border)",
        "border-radius": "6px",
        "color": "var(--text-primary)",
        "padding": "4px 6px",
        "font-size": "12px"
      }
    },
    {
      "selector": ".btn.selection-panel__delete-btn",
      "file": "ui/panels/SelectionPanel/SelectionPanel.css",
      "declarations": {
        "border-radius": "var(--radius-sm)",
        "padding": "9px",
        "justify-content": "center",
        "font-size": "12px",
        "font-weight": "600",
        "color": "var(--danger)",
        "border-color": "var(--danger-soft)"
      }
    },
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    }
  ],
  "inlineStyleBlocks": []
}