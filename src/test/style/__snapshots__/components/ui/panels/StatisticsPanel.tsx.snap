{
  "file": "ui/panels/StatisticsPanel.tsx",
  "classes": [
    "mono",
    "statistics-panel",
    "statistics-panel__card",
    "statistics-panel__card-row",
    "statistics-panel__card-row-label",
    "statistics-panel__card-row-value",
    "statistics-panel__card-title",
    "statistics-panel__colour-item",
    "statistics-panel__colours",
    "statistics-panel__content",
    "statistics-panel__section",
    "statistics-panel__section-grid",
    "statistics-panel__section-summary",
    "statistics-panel__summary-card",
    "statistics-panel__summary-label",
    "statistics-panel__summary-value",
    "statistics-panel__swatch"
  ],
  "cssRules": [
    {
      "selector": ".statistics-panel",
      "file": "ui/panels/StatisticsPanel.css",
      "declarations": {
        "overflow-y": "auto",
        "padding": "24px"
      }
    },
    {
      "selector": ".statistics-panel__content",
      "file": "ui/panels/StatisticsPanel.css",
      "declarations": {
        "max-width": "1000px",
        "display": "flex",
        "flex-direction": "column",
        "gap": "16px"
      }
    },
    {
      "selector": ".statistics-panel__section",
      "file": "ui/panels/StatisticsPanel.css",
      "declarations": {
        "background": "var(--bg-panel)",
        "border": "1px solid var(--border)",
        "border-radius": "var(--radius-md)",
        "padding": "16px"
      }
    },
    {
      "selector": ".statistics-panel__section-summary",
      "file": "ui/panels/StatisticsPanel.css",
      "declarations": {
        "font-weight": "700",
        "font-size": "13px",
        "cursor": "pointer"
      }
    },
    {
      "selector": ".statistics-panel__section-grid",
      "file": "ui/panels/StatisticsPanel.css",
      "declarations": {
        "display": "grid",
        "grid-template-columns": "repeat(auto-fill, minmax(260px, 1fr))",
        "gap": "16px",
        "margin-top": "16px"
      }
    },
    {
      "selector": ".statistics-panel__summary-card",
      "file": "ui/panels/StatisticsPanel.css",
      "declarations": {
        "background": "var(--bg-panel)",
        "border": "1px solid var(--border)",
        "border-radius": "var(--radius-md)",
        "padding": "16px"
      }
    },
    {
      "selector": ".statistics-panel__summary-value",
      "file": "ui/panels/StatisticsPanel.css",
      "declarations": {
        "font-size": "24px",
        "font-weight": "700",
        "color": "var(--accent)"
      }
    },
    {
      "selector": ".statistics-panel__summary-label",
      "file": "ui/panels/StatisticsPanel.css",
      "declarations": {
        "font-size": "12px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".statistics-panel__card",
      "file": "ui/panels/StatisticsPanel.css",
      "declarations": {
        "background": "var(--bg-panel)",
        "border": "1px solid var(--border)",
        "border-radius": "var(--radius-md)",
        "padding": "16px",
        "display": "flex",
        "flex-direction": "column",
        "gap": "8px"
      }
    },
    {
      "selector": ".statistics-panel__card-title",
      "file": "ui/panels/StatisticsPanel.css",
      "declarations": {
        "font-size": "12.5px",
        "font-weight": "700",
        "display": "flex",
        "align-items": "center",
        "gap": "6px"
      }
    },
    {
      "selector": ".statistics-panel__card-row",
      "file": "ui/panels/StatisticsPanel.css",
      "declarations": {
        "display": "flex",
        "justify-content": "space-between",
        "font-size": "12px"
      }
    },
    {
      "selector": ".statistics-panel__card-row-label",
      "file": "ui/panels/StatisticsPanel.css",
      "declarations": {
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".statistics-panel__card-row-value",
      "file": "ui/panels/StatisticsPanel.css",
      "declarations": {
        "color": "var(--text-primary)"
      }
    },
    {
      "selector": ".statistics-panel__colours",
      "file": "ui/panels/StatisticsPanel.css",
      "declarations": {
        "display": "inline-flex",
        "align-items": "center",
        "gap": "6px"
      }
    },
    {
      "selector": ".statistics-panel__colour-item",
      "file": "ui/panels/StatisticsPanel.css",
      "declarations": {
        "display": "inline-flex",
        "align-items": "center",
        "gap": "4px"
      }
    },
    {
      "selector": ".statistics-panel__swatch",
      "file": "ui/panels/StatisticsPanel.css",
      "declarations": {
        "display": "inline-block",
        "width": "14px",
        "height": "10px",
        "border-radius": "2px",
        "border": "1px solid var(--border)",
        "vertical-align": "middle"
      }
    },
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    }
  ],
  "inlineStyleBlocks": [
    "{{ background: colour }}"
  ]
}