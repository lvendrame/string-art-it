{
  "file": "ui/panels/StatisticsPanel/StatCard.tsx",
  "classes": [
    "mono",
    "statistics-panel__card",
    "statistics-panel__card-row",
    "statistics-panel__card-row-label",
    "statistics-panel__card-row-value",
    "statistics-panel__card-title"
  ],
  "cssRules": [
    {
      "selector": ".statistics-panel__card",
      "file": "ui/panels/StatisticsPanel/StatCard.css",
      "declarations": {
        "background": "var(--bg-panel)",
        "border": "1px solid var(--border)",
        "border-radius": "var(--radius-md)",
        "padding": "16px",
        "display": "flex",
        "flex-direction": "column",
        "gap": "8px"
      }
    },
    {
      "selector": ".statistics-panel__card-title",
      "file": "ui/panels/StatisticsPanel/StatCard.css",
      "declarations": {
        "font-size": "12.5px",
        "font-weight": "700",
        "display": "flex",
        "align-items": "center",
        "gap": "6px"
      }
    },
    {
      "selector": ".statistics-panel__card-row",
      "file": "ui/panels/StatisticsPanel/StatCard.css",
      "declarations": {
        "display": "flex",
        "justify-content": "space-between",
        "font-size": "12px"
      }
    },
    {
      "selector": ".statistics-panel__card-row-label",
      "file": "ui/panels/StatisticsPanel/StatCard.css",
      "declarations": {
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".statistics-panel__card-row-value",
      "file": "ui/panels/StatisticsPanel/StatCard.css",
      "declarations": {
        "color": "var(--text-primary)"
      }
    },
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    }
  ],
  "inlineStyleBlocks": []
}