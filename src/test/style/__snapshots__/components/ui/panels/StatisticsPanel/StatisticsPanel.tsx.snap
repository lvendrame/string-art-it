{
  "file": "ui/panels/StatisticsPanel/StatisticsPanel.tsx",
  "classes": [
    "mono",
    "statistics-panel",
    "statistics-panel__content",
    "statistics-panel__summary-card",
    "statistics-panel__summary-label",
    "statistics-panel__summary-value"
  ],
  "cssRules": [
    {
      "selector": ".statistics-panel",
      "file": "ui/panels/StatisticsPanel/StatisticsPanel.css",
      "declarations": {
        "overflow-y": "auto",
        "padding": "24px"
      }
    },
    {
      "selector": ".statistics-panel__content",
      "file": "ui/panels/StatisticsPanel/StatisticsPanel.css",
      "declarations": {
        "max-width": "1000px",
        "display": "flex",
        "flex-direction": "column",
        "gap": "16px"
      }
    },
    {
      "selector": ".statistics-panel__summary-card",
      "file": "ui/panels/StatisticsPanel/StatisticsPanel.css",
      "declarations": {
        "background": "var(--bg-panel)",
        "border": "1px solid var(--border)",
        "border-radius": "var(--radius-md)",
        "padding": "16px"
      }
    },
    {
      "selector": ".statistics-panel__summary-value",
      "file": "ui/panels/StatisticsPanel/StatisticsPanel.css",
      "declarations": {
        "font-size": "24px",
        "font-weight": "700",
        "color": "var(--accent)"
      }
    },
    {
      "selector": ".statistics-panel__summary-label",
      "file": "ui/panels/StatisticsPanel/StatisticsPanel.css",
      "declarations": {
        "font-size": "12px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    }
  ],
  "inlineStyleBlocks": []
}