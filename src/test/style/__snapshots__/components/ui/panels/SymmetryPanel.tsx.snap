{
  "file": "ui/panels/SymmetryPanel.tsx",
  "classes": [
    "btn",
    "btn-active",
    "mono",
    "symmetry-panel",
    "symmetry-panel__grid",
    "symmetry-panel__number-input",
    "symmetry-panel__option-btn",
    "symmetry-panel__radial-box",
    "symmetry-panel__row",
    "symmetry-panel__section-title"
  ],
  "cssRules": [
    {
      "selector": ".symmetry-panel",
      "file": "ui/panels/SymmetryPanel.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "10px"
      }
    },
    {
      "selector": ".symmetry-panel__section-title",
      "file": "ui/panels/SymmetryPanel.css",
      "declarations": {
        "font-size": "11px",
        "font-weight": "700",
        "letter-spacing": "0.06em",
        "color": "var(--text-tertiary)",
        "text-transform": "uppercase"
      }
    },
    {
      "selector": ".symmetry-panel__grid",
      "file": "ui/panels/SymmetryPanel.css",
      "declarations": {
        "display": "grid",
        "grid-template-columns": "repeat(3, 1fr)",
        "gap": "6px"
      }
    },
    {
      "selector": ".symmetry-panel__option-btn",
      "file": "ui/panels/SymmetryPanel.css",
      "declarations": {
        "justify-content": "center",
        "border-radius": "var(--radius-sm)",
        "padding": "9px 4px",
        "font-size": "10.5px",
        "font-weight": "600"
      }
    },
    {
      "selector": ".symmetry-panel__radial-box",
      "file": "ui/panels/SymmetryPanel.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "8px",
        "background": "var(--bg-app)",
        "border": "1px solid var(--border)",
        "border-radius": "var(--radius-md)",
        "padding": "10px"
      }
    },
    {
      "selector": ".symmetry-panel__row",
      "file": "ui/panels/SymmetryPanel.css",
      "declarations": {
        "display": "flex",
        "justify-content": "space-between",
        "align-items": "center",
        "font-size": "11.5px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".symmetry-panel__number-input",
      "file": "ui/panels/SymmetryPanel.css",
      "declarations": {
        "width": "60px",
        "background": "var(--bg-panel-2)",
        "border": "1px solid var(--border)",
        "border-radius": "6px",
        "color": "var(--text-primary)",
        "padding": "3px 6px"
      }
    },
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    },
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".btn-active",
      "file": "ui/theme.css",
      "declarations": {
        "background": "var(--accent-soft)",
        "color": "var(--accent)",
        "border-color": "var(--accent)"
      }
    }
  ],
  "inlineStyleBlocks": []
}