{
  "file": "ui/panels/ThreadPropertiesPanel/ThreadStatsBox.tsx",
  "classes": [
    "mono",
    "thread-properties-panel__box",
    "thread-properties-panel__section-title",
    "thread-properties-panel__stats-label",
    "thread-properties-panel__stats-row",
    "thread-properties-panel__stats-value"
  ],
  "cssRules": [
    {
      "selector": ".thread-properties-panel__section-title",
      "file": "ui/panels/ThreadPropertiesPanel/ThreadPropertiesPanel.css",
      "declarations": {
        "font-size": "11px",
        "font-weight": "700",
        "letter-spacing": "0.06em",
        "color": "var(--text-tertiary)",
        "text-transform": "uppercase"
      }
    },
    {
      "selector": ".thread-properties-panel__box",
      "file": "ui/panels/ThreadPropertiesPanel/ThreadPropertiesPanel.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "8px",
        "border": "1px solid var(--border)",
        "border-radius": "var(--radius-md)",
        "padding": "10px",
        "margin-top": "4px"
      }
    },
    {
      "selector": ".thread-properties-panel__stats-row",
      "file": "ui/panels/ThreadPropertiesPanel/ThreadStatsBox.css",
      "declarations": {
        "display": "flex",
        "justify-content": "space-between",
        "font-size": "12px"
      }
    },
    {
      "selector": ".thread-properties-panel__stats-label",
      "file": "ui/panels/ThreadPropertiesPanel/ThreadStatsBox.css",
      "declarations": {
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".thread-properties-panel__stats-value",
      "file": "ui/panels/ThreadPropertiesPanel/ThreadStatsBox.css",
      "declarations": {
        "color": "var(--text-primary)"
      }
    },
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    }
  ],
  "inlineStyleBlocks": []
}