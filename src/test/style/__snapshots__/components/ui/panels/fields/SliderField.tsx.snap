{
  "file": "ui/panels/fields/SliderField.tsx",
  "classes": [
    "is-disabled",
    "mono",
    "slider-field",
    "slider-field-range",
    "slider-field__row",
    "slider-field__value"
  ],
  "cssRules": [
    {
      "selector": ".slider-field",
      "file": "ui/panels/fields/SliderField.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "3px"
      }
    },
    {
      "selector": ".slider-field__row",
      "file": "ui/panels/fields/SliderField.css",
      "declarations": {
        "display": "flex",
        "justify-content": "space-between",
        "align-items": "center",
        "font-size": "11.5px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".slider-field__value",
      "file": "ui/panels/fields/SliderField.css",
      "declarations": {
        "color": "var(--text-primary)",
        "font-size": "11.5px",
        "min-width": "34px",
        "text-align": "right"
      }
    },
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    },
    {
      "selector": ".is-disabled",
      "file": "ui/theme.css",
      "declarations": {
        "opacity": "0.5"
      }
    },
    {
      "selector": ".slider-field-range",
      "file": "ui/theme.css",
      "declarations": {
        "-webkit-appearance": "none",
        "appearance": "none",
        "width": "100%",
        "height": "6px",
        "border-radius": "var(--radius-sm)",
        "background": "var(--bg-panel-2)",
        "border": "1px solid var(--border)",
        "cursor": "pointer"
      }
    }
  ],
  "inlineStyleBlocks": []
}