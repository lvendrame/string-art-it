{
  "file": "ui/panels/fields/SliderField.tsx",
  "classes": [
    "mono",
    "slider-field-range"
  ],
  "cssRules": [
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    },
    {
      "selector": ".slider-field-range",
      "file": "ui/theme.css",
      "declarations": {
        "-webkit-appearance": "none",
        "appearance": "none",
        "width": "100%",
        "height": "6px",
        "border-radius": "var(--radius-sm)",
        "background": "var(--bg-panel-2)",
        "border": "1px solid var(--border)",
        "cursor": "pointer"
      }
    }
  ],
  "inlineStyleBlocks": [
    "{{ display: \"flex\", flexDirection: \"column\", gap: 3, opacity: disabled ? 0.5 : 1 }}",
    "{FIELD_LABEL_STYLE}",
    "{SLIDER_VALUE_STYLE}"
  ]
}