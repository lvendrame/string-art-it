{
  "file": "ui/panels/help/AboutTabContent.tsx",
  "classes": [
    "about-tab-content",
    "about-tab-content__app-info",
    "about-tab-content__field",
    "about-tab-content__field--textarea",
    "about-tab-content__field-label",
    "about-tab-content__form",
    "about-tab-content__intro",
    "about-tab-content__property-label",
    "about-tab-content__property-row",
    "about-tab-content__property-value",
    "about-tab-content__section-heading",
    "about-tab-content__send",
    "about-tab-content__send--ready",
    "btn",
    "is-disabled",
    "mono"
  ],
  "cssRules": [
    {
      "selector": ".about-tab-content",
      "file": "ui/panels/help/AboutTabContent.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "24px"
      }
    },
    {
      "selector": ".about-tab-content__section-heading",
      "file": "ui/panels/help/AboutTabContent.css",
      "declarations": {
        "font-size": "12.5px",
        "font-weight": "700",
        "margin-bottom": "8px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".about-tab-content__app-info",
      "file": "ui/panels/help/AboutTabContent.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "8px",
        "max-width": "420px"
      }
    },
    {
      "selector": ".about-tab-content__intro",
      "file": "ui/panels/help/AboutTabContent.css",
      "declarations": {
        "font-size": "12px",
        "color": "var(--text-secondary)",
        "max-width": "420px",
        "margin-top": "0"
      }
    },
    {
      "selector": ".about-tab-content__form",
      "file": "ui/panels/help/AboutTabContent.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "12px",
        "max-width": "420px"
      }
    },
    {
      "selector": ".about-tab-content__field-label",
      "file": "ui/panels/help/AboutTabContent.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "4px",
        "font-size": "12px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".about-tab-content__field",
      "file": "ui/panels/help/AboutTabContent.css",
      "declarations": {
        "background": "var(--bg-panel-2)",
        "border": "1px solid var(--border)",
        "border-radius": "var(--radius-sm)",
        "color": "var(--text-primary)",
        "padding": "6px 8px",
        "font-size": "12.5px",
        "font-family": "inherit"
      }
    },
    {
      "selector": ".about-tab-content__field--textarea",
      "file": "ui/panels/help/AboutTabContent.css",
      "declarations": {
        "resize": "vertical",
        "min-height": "90px"
      }
    },
    {
      "selector": ".about-tab-content__send",
      "file": "ui/panels/help/AboutTabContent.css",
      "declarations": {
        "align-self": "flex-start",
        "justify-content": "center",
        "border-radius": "var(--radius-sm)",
        "padding": "8px 16px",
        "font-size": "12px",
        "font-weight": "700",
        "gap": "6px",
        "text-decoration": "none"
      }
    },
    {
      "selector": ".btn.about-tab-content__send--ready",
      "file": "ui/panels/help/AboutTabContent.css",
      "declarations": {
        "background": "var(--accent-strong)",
        "color": "#fff",
        "border-color": "var(--accent-strong)"
      }
    },
    {
      "selector": ".about-tab-content__send.is-disabled",
      "file": "ui/panels/help/AboutTabContent.css",
      "declarations": {
        "pointer-events": "none"
      }
    },
    {
      "selector": ".about-tab-content__property-row",
      "file": "ui/panels/help/AboutTabContent.css",
      "declarations": {
        "display": "flex",
        "justify-content": "space-between",
        "gap": "12px",
        "background": "var(--bg-app)",
        "border": "1px solid var(--border)",
        "border-radius": "var(--radius-md)",
        "padding": "12px"
      }
    },
    {
      "selector": ".about-tab-content__property-label",
      "file": "ui/panels/help/AboutTabContent.css",
      "declarations": {
        "font-size": "12px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".about-tab-content__property-value",
      "file": "ui/panels/help/AboutTabContent.css",
      "declarations": {
        "font-size": "12px",
        "font-weight": "600",
        "color": "var(--text-primary)",
        "text-align": "right"
      }
    },
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    },
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".is-disabled",
      "file": "ui/theme.css",
      "declarations": {
        "opacity": "0.5"
      }
    }
  ],
  "inlineStyleBlocks": []
}