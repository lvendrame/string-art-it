{
  "file": "ui/panels/help/HelpPanel/HelpPanel.tsx",
  "classes": [
    "btn",
    "help-panel",
    "help-panel__tab",
    "help-panel__tabpanel",
    "help-panel__tabs",
    "tab-underline",
    "tab-underline--active"
  ],
  "cssRules": [
    {
      "selector": ".help-panel",
      "file": "ui/panels/help/HelpPanel/HelpPanel.css",
      "declarations": {
        "overflow-y": "auto",
        "padding": "24px"
      }
    },
    {
      "selector": ".help-panel__tabs",
      "file": "ui/panels/help/HelpPanel/HelpPanel.css",
      "declarations": {
        "display": "flex",
        "flex-wrap": "wrap",
        "border-bottom": "1px solid var(--border)",
        "margin-bottom": "20px"
      }
    },
    {
      "selector": ".help-panel__tab",
      "file": "ui/panels/help/HelpPanel/HelpPanel.css",
      "declarations": {
        "flex": "0 0 auto",
        "justify-content": "center",
        "padding": "9px 14px",
        "font-size": "12px",
        "font-weight": "700",
        "gap": "6px"
      }
    },
    {
      "selector": ".help-panel__tabpanel",
      "file": "ui/panels/help/HelpPanel/HelpPanel.css",
      "declarations": {
        "max-width": "720px",
        "display": "flex",
        "flex-direction": "column",
        "gap": "20px"
      }
    },
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".tab-underline",
      "file": "ui/theme.css",
      "declarations": {
        "border": "none",
        "border-radius": "0",
        "background": "transparent",
        "color": "var(--text-tertiary)",
        "cursor": "pointer",
        "border-bottom": "2px solid transparent"
      }
    },
    {
      "selector": ".tab-underline--active",
      "file": "ui/theme.css",
      "declarations": {
        "color": "var(--text-primary)",
        "border-bottom-color": "var(--accent)"
      }
    },
    {
      "selector": ".btn.tab-underline",
      "file": "ui/theme.css",
      "declarations": {
        "border": "none",
        "background": "transparent",
        "color": "var(--text-tertiary)",
        "border-bottom": "2px solid transparent"
      }
    },
    {
      "selector": ".btn.tab-underline.tab-underline--active",
      "file": "ui/theme.css",
      "declarations": {
        "color": "var(--text-primary)",
        "border-bottom-color": "var(--accent)"
      }
    }
  ],
  "inlineStyleBlocks": []
}