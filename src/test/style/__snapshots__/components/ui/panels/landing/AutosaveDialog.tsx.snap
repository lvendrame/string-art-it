{
  "file": "ui/panels/landing/AutosaveDialog.tsx",
  "classes": [
    "autosave-dialog",
    "autosave-dialog__discard",
    "autosave-dialog__restore",
    "btn"
  ],
  "cssRules": [
    {
      "selector": ".autosave-dialog",
      "file": "ui/panels/landing/AutosaveDialog.css",
      "declarations": {
        "position": "fixed",
        "top": "12px",
        "left": "50%",
        "transform": "translateX(-50%)",
        "z-index": "100",
        "display": "flex",
        "align-items": "center",
        "gap": "12px",
        "background": "var(--bg-panel)",
        "border": "1px solid var(--accent)",
        "border-radius": "var(--radius-md)",
        "padding": "10px 16px",
        "font-size": "12.5px",
        "color": "var(--text-primary)",
        "box-shadow": "0 4px 20px rgba(0, 0, 0, 0.4)"
      }
    },
    {
      "selector": ".autosave-dialog__restore",
      "file": "ui/panels/landing/AutosaveDialog.css",
      "declarations": {
        "border-radius": "6px",
        "padding": "5px 10px",
        "font-size": "12px"
      }
    },
    {
      "selector": ".autosave-dialog__discard",
      "file": "ui/panels/landing/AutosaveDialog.css",
      "declarations": {
        "border-radius": "6px",
        "padding": "5px 10px",
        "font-size": "12px"
      }
    },
    {
      "selector": ".btn.autosave-dialog__restore",
      "file": "ui/panels/landing/AutosaveDialog.css",
      "declarations": {
        "font-weight": "600",
        "background": "var(--accent-strong)",
        "color": "white",
        "border-color": "transparent"
      }
    },
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    }
  ],
  "inlineStyleBlocks": []
}