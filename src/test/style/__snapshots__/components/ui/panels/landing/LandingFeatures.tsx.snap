{
  "file": "ui/panels/landing/LandingFeatures.tsx",
  "classes": [
    "landing-features",
    "landing-features__card",
    "landing-features__description",
    "landing-features__grid",
    "landing-features__heading",
    "landing-features__icon",
    "landing-features__title"
  ],
  "cssRules": [
    {
      "selector": ".landing-features",
      "file": "ui/panels/landing/LandingFeatures.css",
      "declarations": {
        "max-width": "760px",
        "margin": "40px auto 0",
        "padding": "0 24px"
      }
    },
    {
      "selector": ".landing-features__heading",
      "file": "ui/panels/landing/LandingFeatures.css",
      "declarations": {
        "font-size": "11px",
        "font-weight": "700",
        "letter-spacing": "0.06em",
        "color": "var(--text-tertiary)",
        "text-transform": "uppercase",
        "margin-bottom": "12px",
        "text-align": "center"
      }
    },
    {
      "selector": ".landing-features__grid",
      "file": "ui/panels/landing/LandingFeatures.css",
      "declarations": {
        "display": "grid",
        "grid-template-columns": "repeat(auto-fit, minmax(180px, 1fr))",
        "gap": "12px"
      }
    },
    {
      "selector": ".landing-features__card",
      "file": "ui/panels/landing/LandingFeatures.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "6px",
        "background": "var(--bg-app)",
        "border": "1px solid var(--border)",
        "border-radius": "var(--radius-md)",
        "padding": "12px"
      }
    },
    {
      "selector": ".landing-features__icon",
      "file": "ui/panels/landing/LandingFeatures.css",
      "declarations": {
        "color": "var(--accent)",
        "display": "flex"
      }
    },
    {
      "selector": ".landing-features__title",
      "file": "ui/panels/landing/LandingFeatures.css",
      "declarations": {
        "font-size": "13px",
        "font-weight": "700",
        "color": "var(--text-primary)"
      }
    },
    {
      "selector": ".landing-features__description",
      "file": "ui/panels/landing/LandingFeatures.css",
      "declarations": {
        "font-size": "12px",
        "color": "var(--text-secondary)"
      }
    }
  ],
  "inlineStyleBlocks": []
}