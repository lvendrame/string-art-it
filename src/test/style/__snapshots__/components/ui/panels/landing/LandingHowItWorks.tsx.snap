{
  "file": "ui/panels/landing/LandingHowItWorks.tsx",
  "classes": [
    "landing-how-it-works",
    "landing-how-it-works__heading",
    "landing-how-it-works__list",
    "landing-how-it-works__step",
    "landing-how-it-works__step-description",
    "landing-how-it-works__step-index",
    "landing-how-it-works__step-title",
    "mono"
  ],
  "cssRules": [
    {
      "selector": ".landing-how-it-works",
      "file": "ui/panels/landing/LandingHowItWorks.css",
      "declarations": {
        "max-width": "760px",
        "margin": "40px auto 0",
        "padding": "0 24px"
      }
    },
    {
      "selector": ".landing-how-it-works__heading",
      "file": "ui/panels/landing/LandingHowItWorks.css",
      "declarations": {
        "font-size": "11px",
        "font-weight": "700",
        "letter-spacing": "0.06em",
        "color": "var(--text-tertiary)",
        "text-transform": "uppercase",
        "margin-bottom": "12px",
        "text-align": "center"
      }
    },
    {
      "selector": ".landing-how-it-works__list",
      "file": "ui/panels/landing/LandingHowItWorks.css",
      "declarations": {
        "list-style": "none",
        "margin": "0",
        "padding": "0",
        "display": "flex",
        "flex-direction": "column",
        "gap": "10px"
      }
    },
    {
      "selector": ".landing-how-it-works__step",
      "file": "ui/panels/landing/LandingHowItWorks.css",
      "declarations": {
        "display": "flex",
        "gap": "12px",
        "align-items": "flex-start",
        "background": "var(--bg-app)",
        "border": "1px solid var(--border)",
        "border-radius": "var(--radius-md)",
        "padding": "12px"
      }
    },
    {
      "selector": ".landing-how-it-works__step-index",
      "file": "ui/panels/landing/LandingHowItWorks.css",
      "declarations": {
        "flex": "0 0 24px",
        "height": "24px",
        "border-radius": "999px",
        "background": "var(--accent-soft)",
        "color": "var(--accent)",
        "font-size": "12px",
        "font-weight": "700",
        "display": "flex",
        "align-items": "center",
        "justify-content": "center"
      }
    },
    {
      "selector": ".landing-how-it-works__step-title",
      "file": "ui/panels/landing/LandingHowItWorks.css",
      "declarations": {
        "font-size": "13px",
        "font-weight": "700",
        "color": "var(--text-primary)"
      }
    },
    {
      "selector": ".landing-how-it-works__step-description",
      "file": "ui/panels/landing/LandingHowItWorks.css",
      "declarations": {
        "font-size": "12px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    }
  ],
  "inlineStyleBlocks": []
}