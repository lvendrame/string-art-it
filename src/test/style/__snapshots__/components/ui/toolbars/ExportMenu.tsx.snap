{
  "file": "ui/toolbars/ExportMenu.tsx",
  "classes": [
    "btn",
    "export-menu__dpi-input",
    "export-menu__dpi-row",
    "export-menu__item",
    "export-menu__panel",
    "export-menu__trigger",
    "mono",
    "popover-trigger"
  ],
  "cssRules": [
    {
      "selector": ".popover-trigger",
      "file": "ui/AnchoredPopover.css",
      "declarations": {
        "position": "relative"
      }
    },
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    },
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".export-menu__trigger",
      "file": "ui/toolbars/ExportMenu.css",
      "declarations": {
        "border-radius": "8px",
        "padding": "7px 12px",
        "font-size": "12px",
        "font-weight": "600",
        "gap": "6px"
      }
    },
    {
      "selector": ".export-menu__panel",
      "file": "ui/toolbars/ExportMenu.css",
      "declarations": {
        "padding": "10px",
        "display": "flex",
        "flex-direction": "column",
        "gap": "6px",
        "min-width": "180px"
      }
    },
    {
      "selector": ".export-menu__item",
      "file": "ui/toolbars/ExportMenu.css",
      "declarations": {
        "justify-content": "flex-start",
        "border-radius": "6px",
        "padding": "8px",
        "font-size": "12px",
        "gap": "6px"
      }
    },
    {
      "selector": ".export-menu__dpi-row",
      "file": "ui/toolbars/ExportMenu.css",
      "declarations": {
        "display": "flex",
        "justify-content": "space-between",
        "align-items": "center",
        "font-size": "11.5px",
        "color": "var(--text-secondary)",
        "margin-top": "4px"
      }
    },
    {
      "selector": ".export-menu__dpi-input",
      "file": "ui/toolbars/ExportMenu.css",
      "declarations": {
        "width": "60px",
        "background": "var(--bg-panel-2)",
        "border": "1px solid var(--border)",
        "border-radius": "6px",
        "color": "var(--text-primary)",
        "padding": "3px 6px"
      }
    }
  ],
  "inlineStyleBlocks": []
}