{
  "file": "ui/toolbars/FileMenu.tsx",
  "classes": [
    "btn",
    "file-menu",
    "file-menu__btn",
    "file-menu__file-input"
  ],
  "cssRules": [
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".file-menu",
      "file": "ui/toolbars/FileMenu.css",
      "declarations": {
        "display": "flex",
        "gap": "6px"
      }
    },
    {
      "selector": ".file-menu__btn",
      "file": "ui/toolbars/FileMenu.css",
      "declarations": {
        "border-radius": "8px",
        "padding": "7px 12px",
        "font-size": "12px",
        "font-weight": "600",
        "gap": "6px"
      }
    },
    {
      "selector": ".file-menu__file-input",
      "file": "ui/toolbars/FileMenu.css",
      "declarations": {
        "display": "none"
      }
    }
  ],
  "inlineStyleBlocks": []
}