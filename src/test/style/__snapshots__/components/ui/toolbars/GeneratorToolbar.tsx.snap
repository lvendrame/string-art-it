{
  "file": "ui/toolbars/GeneratorToolbar.tsx",
  "classes": [
    "btn",
    "generator-toolbar",
    "generator-toolbar__picker",
    "generator-toolbar__picker-label",
    "generator-toolbar__section-title",
    "generator-toolbar__select"
  ],
  "cssRules": [
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".generator-toolbar",
      "file": "ui/toolbars/GeneratorToolbar.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "10px"
      }
    },
    {
      "selector": ".generator-toolbar__section-title",
      "file": "ui/toolbars/GeneratorToolbar.css",
      "declarations": {
        "font-size": "11px",
        "font-weight": "700",
        "letter-spacing": "0.06em",
        "color": "var(--text-tertiary)",
        "text-transform": "uppercase"
      }
    },
    {
      "selector": ".generator-toolbar__picker",
      "file": "ui/toolbars/GeneratorToolbar.css",
      "declarations": {
        "width": "100%",
        "justify-content": "space-between",
        "border-radius": "var(--radius-sm)",
        "padding": "9px 10px",
        "gap": "6px"
      }
    },
    {
      "selector": ".generator-toolbar__picker-label",
      "file": "ui/toolbars/GeneratorToolbar.css",
      "declarations": {
        "display": "flex",
        "align-items": "center",
        "gap": "6px",
        "font-size": "12px",
        "font-weight": "600"
      }
    },
    {
      "selector": ".generator-toolbar__select",
      "file": "ui/toolbars/GeneratorToolbar.css",
      "declarations": {
        "background": "transparent",
        "color": "inherit",
        "border": "none",
        "font-size": "12px"
      }
    }
  ],
  "inlineStyleBlocks": []
}