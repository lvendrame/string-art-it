{
  "file": "ui/toolbars/ModeSwitcher.tsx",
  "classes": [
    "btn",
    "btn-active",
    "mode-switcher",
    "mode-switcher__tab"
  ],
  "cssRules": [
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".btn-active",
      "file": "ui/theme.css",
      "declarations": {
        "background": "var(--accent-soft)",
        "color": "var(--accent)",
        "border-color": "var(--accent)"
      }
    },
    {
      "selector": ".mode-switcher",
      "file": "ui/toolbars/ModeSwitcher.css",
      "declarations": {
        "display": "flex",
        "background": "var(--bg-app)",
        "border": "1px solid var(--border)",
        "border-radius": "var(--radius-md)",
        "padding": "3px",
        "gap": "2px"
      }
    },
    {
      "selector": ".btn.mode-switcher__tab",
      "file": "ui/toolbars/ModeSwitcher.css",
      "declarations": {
        "border": "none",
        "border-radius": "8px",
        "padding": "7px 14px",
        "font-size": "12.5px",
        "font-weight": "600",
        "gap": "6px",
        "background": "transparent",
        "border-color": "transparent"
      }
    },
    {
      "selector": ".btn.mode-switcher__tab.btn-active",
      "file": "ui/toolbars/ModeSwitcher.css",
      "declarations": {
        "background": "var(--accent-soft)",
        "border-color": "var(--accent)"
      }
    }
  ],
  "inlineStyleBlocks": []
}