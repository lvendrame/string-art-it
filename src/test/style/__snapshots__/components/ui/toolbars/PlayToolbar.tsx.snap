{
  "file": "ui/toolbars/PlayToolbar.tsx",
  "classes": [
    "btn",
    "btn-active",
    "mono"
  ],
  "cssRules": [
    {
      "selector": ".mono",
      "file": "ui/theme.css",
      "declarations": {
        "font-family": "\"JetBrains Mono\", ui-monospace, monospace"
      }
    },
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".btn-active",
      "file": "ui/theme.css",
      "declarations": {
        "background": "var(--accent-soft)",
        "color": "var(--accent)",
        "border-color": "var(--accent)"
      }
    }
  ],
  "inlineStyleBlocks": [
    "{{ display: \"flex\", flexDirection: \"column\", gap: 10 }}",
    "{{ fontSize: 11, fontWeight: 700, letterSpacing: \"0.06em\", color: \"var(--text-tertiary)\", textTransform: \"uppercase\" }}",
    "{{ display: \"flex\", alignItems: \"center\", justifyContent: \"center\", gap: 6 }}",
    "{STEP_BUTTON_STYLE}",
    "{STEP_BUTTON_STYLE}",
    "{{ justifyContent: \"center\", borderRadius: \"var(--radius-md)\", padding: 12, ...(transport.isPlaying ? {} : { background: \"var(--accent)\", color: \"#fff\", borderColor: \"var(--accent)\" }) }}",
    "{STEP_BUTTON_STYLE}",
    "{STEP_BUTTON_STYLE}",
    "{{ display: \"flex\", gap: 8 }}",
    "{{ display: \"flex\", flexDirection: \"column\", gap: 4, fontSize: 12, color: \"var(--text-secondary)\" }}",
    "{NUMBER_INPUT_STYLE}",
    "{{ display: \"flex\", flexDirection: \"column\", gap: 4, fontSize: 12, color: \"var(--text-secondary)\" }}",
    "{{ ...NUMBER_INPUT_STYLE, color: \"var(--text-tertiary)\" }}",
    "{{ display: \"flex\", justifyContent: \"space-between\", alignItems: \"center\", fontSize: 12, color: \"var(--text-secondary)\" }}",
    "{NUMBER_INPUT_STYLE}",
    "{{ justifyContent: \"center\", borderRadius: \"var(--radius-sm)\", padding: 9, fontSize: 12, fontWeight: 600, gap: 6 }}",
    "{{ fontSize: 11, color: \"var(--text-tertiary)\" }}"
  ]
}