{
  "file": "ui/toolbars/SelectToolbar.tsx",
  "classes": [
    "btn",
    "btn-active",
    "select-toolbar",
    "select-toolbar__granularity",
    "select-toolbar__granularity-label",
    "select-toolbar__granularity-label--active",
    "select-toolbar__grid",
    "select-toolbar__knob",
    "select-toolbar__knob--pins",
    "select-toolbar__merge-btn",
    "select-toolbar__section-title",
    "select-toolbar__switch",
    "select-toolbar__tool",
    "select-toolbar__track"
  ],
  "cssRules": [
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".btn-active",
      "file": "ui/theme.css",
      "declarations": {
        "background": "var(--accent-soft)",
        "color": "var(--accent)",
        "border-color": "var(--accent)"
      }
    },
    {
      "selector": ".select-toolbar",
      "file": "ui/toolbars/SelectToolbar.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "10px"
      }
    },
    {
      "selector": ".select-toolbar__section-title",
      "file": "ui/toolbars/SelectToolbar.css",
      "declarations": {
        "font-size": "11px",
        "font-weight": "700",
        "letter-spacing": "0.06em",
        "color": "var(--text-tertiary)",
        "text-transform": "uppercase"
      }
    },
    {
      "selector": ".select-toolbar__granularity",
      "file": "ui/toolbars/SelectToolbar.css",
      "declarations": {
        "display": "flex",
        "align-items": "center",
        "gap": "8px"
      }
    },
    {
      "selector": ".select-toolbar__granularity-label",
      "file": "ui/toolbars/SelectToolbar.css",
      "declarations": {
        "background": "none",
        "border": "none",
        "padding": "0",
        "cursor": "pointer",
        "font-size": "12px",
        "font-weight": "600",
        "color": "var(--text-secondary)",
        "transition": "color 120ms ease"
      }
    },
    {
      "selector": ".select-toolbar__granularity-label--active",
      "file": "ui/toolbars/SelectToolbar.css",
      "declarations": {
        "color": "var(--accent)"
      }
    },
    {
      "selector": ".select-toolbar__switch",
      "file": "ui/toolbars/SelectToolbar.css",
      "declarations": {
        "position": "relative",
        "width": "44px",
        "height": "32px",
        "background": "none",
        "border": "none",
        "padding": "0",
        "cursor": "pointer",
        "flex-shrink": "0"
      }
    },
    {
      "selector": ".select-toolbar__track",
      "file": "ui/toolbars/SelectToolbar.css",
      "declarations": {
        "position": "absolute",
        "top": "50%",
        "left": "50%",
        "transform": "translate(-50%, -50%)",
        "width": "40px",
        "height": "20px",
        "border-radius": "999px",
        "border": "1px solid var(--border)",
        "background": "var(--bg-app)"
      }
    },
    {
      "selector": ".select-toolbar__knob",
      "file": "ui/toolbars/SelectToolbar.css",
      "declarations": {
        "position": "absolute",
        "top": "50%",
        "left": "5px",
        "width": "14px",
        "height": "14px",
        "border-radius": "50%",
        "background": "var(--accent)",
        "transform": "translateY(-50%)",
        "transition": "left 150ms ease"
      }
    },
    {
      "selector": ".select-toolbar__knob--pins",
      "file": "ui/toolbars/SelectToolbar.css",
      "declarations": {
        "left": "25px"
      }
    },
    {
      "selector": ".select-toolbar__grid",
      "file": "ui/toolbars/SelectToolbar.css",
      "declarations": {
        "display": "grid",
        "grid-template-columns": "repeat(2, 1fr)",
        "gap": "6px"
      }
    },
    {
      "selector": ".select-toolbar__tool",
      "file": "ui/toolbars/SelectToolbar.css",
      "declarations": {
        "flex-direction": "column",
        "border-radius": "var(--radius-sm)",
        "padding": "10px 4px 7px",
        "gap": "5px",
        "font-size": "11px",
        "font-weight": "600"
      }
    },
    {
      "selector": ".select-toolbar__merge-btn",
      "file": "ui/toolbars/SelectToolbar.css",
      "declarations": {
        "justify-content": "center",
        "border-radius": "var(--radius-sm)",
        "padding": "9px",
        "gap": "6px",
        "font-size": "12px",
        "font-weight": "600"
      }
    }
  ],
  "inlineStyleBlocks": []
}