{
  "file": "ui/toolbars/ThreadToolbar.tsx",
  "classes": [
    "btn",
    "btn-active",
    "thread-toolbar",
    "thread-toolbar__legend",
    "thread-toolbar__legend-label",
    "thread-toolbar__legend-row",
    "thread-toolbar__section-title",
    "thread-toolbar__swatch-candidate",
    "thread-toolbar__swatch-candidate-dot",
    "thread-toolbar__swatch-candidate-ring",
    "thread-toolbar__swatch-dot",
    "thread-toolbar__swatch-dot--active",
    "thread-toolbar__swatch-dot--normal",
    "thread-toolbar__swatch-dot--used",
    "thread-toolbar__tool",
    "thread-toolbar__tooldraw",
    "thread-toolbar__tooleraser",
    "thread-toolbar__toolparabolic",
    "thread-toolbar__tools",
    "thread-toolbar__toolsegment-eraser",
    "thread-toolbar__toolselect",
    "thread-toolbar__toolzigzag"
  ],
  "cssRules": [
    {
      "selector": ".btn",
      "file": "ui/theme.css",
      "declarations": {
        "border": "1px solid var(--border)",
        "background": "var(--bg-panel-2)",
        "color": "var(--text-secondary)",
        "cursor": "pointer",
        "display": "flex",
        "align-items": "center",
        "transition": "background 120ms ease,\n    color 120ms ease,\n    border-color 120ms ease"
      }
    },
    {
      "selector": ".btn-active",
      "file": "ui/theme.css",
      "declarations": {
        "background": "var(--accent-soft)",
        "color": "var(--accent)",
        "border-color": "var(--accent)"
      }
    },
    {
      "selector": ".thread-toolbar",
      "file": "ui/toolbars/ThreadToolbar.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "10px"
      }
    },
    {
      "selector": ".thread-toolbar__section-title",
      "file": "ui/toolbars/ThreadToolbar.css",
      "declarations": {
        "font-size": "11px",
        "font-weight": "700",
        "letter-spacing": "0.06em",
        "color": "var(--text-tertiary)",
        "text-transform": "uppercase"
      }
    },
    {
      "selector": ".thread-toolbar__tools",
      "file": "ui/toolbars/ThreadToolbar.css",
      "declarations": {
        "display": "flex",
        "gap": "6px",
        "flex-wrap": "wrap"
      }
    },
    {
      "selector": ".thread-toolbar__tool",
      "file": "ui/toolbars/ThreadToolbar.css",
      "declarations": {
        "flex": "1",
        "justify-content": "center",
        "border-radius": "var(--radius-sm)",
        "padding": "9px",
        "font-size": "12px",
        "font-weight": "600",
        "gap": "6px"
      }
    },
    {
      "selector": ".thread-toolbar__legend",
      "file": "ui/toolbars/ThreadToolbar.css",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "8px",
        "background": "var(--bg-app)",
        "border": "1px solid var(--border)",
        "border-radius": "var(--radius-md)",
        "padding": "10px 12px",
        "margin-top": "4px"
      }
    },
    {
      "selector": ".thread-toolbar__legend-row",
      "file": "ui/toolbars/ThreadToolbar.css",
      "declarations": {
        "display": "flex",
        "align-items": "center",
        "gap": "9px"
      }
    },
    {
      "selector": ".thread-toolbar__legend-label",
      "file": "ui/toolbars/ThreadToolbar.css",
      "declarations": {
        "font-size": "11.5px",
        "color": "var(--text-secondary)"
      }
    },
    {
      "selector": ".thread-toolbar__swatch-dot",
      "file": "ui/toolbars/ThreadToolbar.css",
      "declarations": {
        "width": "10px",
        "height": "10px",
        "border-radius": "50%",
        "display": "inline-block"
      }
    },
    {
      "selector": ".thread-toolbar__swatch-dot--normal",
      "file": "ui/toolbars/ThreadToolbar.css",
      "declarations": {
        "background": "#c7cad3"
      }
    },
    {
      "selector": ".thread-toolbar__swatch-dot--active",
      "file": "ui/toolbars/ThreadToolbar.css",
      "declarations": {
        "background": "var(--accent)"
      }
    },
    {
      "selector": ".thread-toolbar__swatch-dot--used",
      "file": "ui/toolbars/ThreadToolbar.css",
      "declarations": {
        "background": "var(--accent)",
        "opacity": "0.5"
      }
    },
    {
      "selector": ".thread-toolbar__swatch-candidate",
      "file": "ui/toolbars/ThreadToolbar.css",
      "declarations": {
        "position": "relative",
        "width": "14px",
        "height": "14px",
        "display": "inline-flex",
        "align-items": "center",
        "justify-content": "center"
      }
    },
    {
      "selector": ".thread-toolbar__swatch-candidate-ring",
      "file": "ui/toolbars/ThreadToolbar.css",
      "declarations": {
        "position": "absolute",
        "inset": "0",
        "border-radius": "50%",
        "border": "1.5px solid #e8b449"
      }
    },
    {
      "selector": ".thread-toolbar__swatch-candidate-dot",
      "file": "ui/toolbars/ThreadToolbar.css",
      "declarations": {
        "width": "7px",
        "height": "7px",
        "border-radius": "50%",
        "background": "#e8b449"
      }
    }
  ],
  "inlineStyleBlocks": []
}